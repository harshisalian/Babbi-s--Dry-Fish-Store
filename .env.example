# Copy this file to a new file named ".env" (same folder) and fill in your values.
# Find them in Supabase: Project Settings -> API (Project URL and the anon / publishable key).
# The anon key is safe to use in the website. NEVER paste the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
